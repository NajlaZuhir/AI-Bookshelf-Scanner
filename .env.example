# OpenRouter API configuration
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional OCR fallback; configure Google Cloud credentials before enabling.
GOOGLE_VISION_FALLBACK_ENABLED=false

# Per-IP limits for the image-upload endpoint.
SCAN_RATE_LIMIT=3/minute;20/hour

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=book_shelf
DB_USER=postgres
DB_PASSWORD=your-database-password
